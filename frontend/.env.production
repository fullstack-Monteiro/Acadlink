# AcadLink Frontend - Production Environment Variables
# Estas variáveis serão configuradas na Vercel

# API Configuration
# IMPORTANTE: Alterar para o URL real do backend quando estiver em produção
VITE_API_URL=https://seu-backend.railway.app/api

# Google OAuth
# Usar o mesmo Client ID ou criar um novo para produção
# Lembrar de adicionar o domínio Vercel nas URLs autorizadas no Google Console
VITE_GOOGLE_CLIENT_ID=334501690060-g0btikdp1j27ugtnc9ngcaguvkodko04.apps.googleusercontent.com

# App Environment
VITE_APP_ENV=production

# Mock Mode — desativar em produção quando o backend estiver pronto
VITE_MOCK_MODE=true

# Debug Mode — desativar em produção
VITE_DEBUG_MODE=false
