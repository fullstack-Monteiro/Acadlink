# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=acadlink_db
DB_USER=acadlink_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# CORS (desenvolvimento: localhost / produção: seus domínios)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# CSRF Trusted Origins (POST, PUT, DELETE permitidos apenas destes domínios)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Produção - Descomente e atualize com seus domínios:
# CORS_ALLOWED_ORIGINS=https://acadlink.vercel.app,https://www.acadlink.com
# CSRF_TRUSTED_ORIGINS=https://acadlink.vercel.app,https://www.acadlink.com

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Email (opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Redis (para cache e Celery)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS S3 (opcional, para upload de arquivos)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Video Processing
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv
VIDEO_PROCESSING_TIMEOUT=3600

# Rate Limiting (AXES - Brute Force Protection)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
AXES_LOCK_OUT_AT_FAILURE=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Logging
LOG_LEVEL=INFO
